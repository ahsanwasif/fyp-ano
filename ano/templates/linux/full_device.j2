{# Linux server / firewall from the Flow B intake: one shell script, run over SSH as root (or via sudo).
   Only what the intake states is configured. The management interface is left exactly as it is. #}
#!/bin/sh
# ANO Linux config of {{ dev.name }} (role: {{ dev.role }})
hostname {{ dev.name }}
sysctl -w net.ipv4.ip_forward={{ 1 if forwards else 0 }}
{% for i in ifaces if i.ip %}
ip addr replace {{ i.ip }} dev {{ i.name }}
ip link set {{ i.name }} up
{% if i.mtu %}
ip link set {{ i.name }} mtu {{ i.mtu }}
{% endif %}
{% endfor %}
{% for r in statics %}
{% if r.next_hop == "blackhole" %}
ip route replace blackhole {{ r.prefix }}
{% else %}
ip route replace {{ "default" if r.prefix|string == "0.0.0.0/0" else r.prefix }} via {{ r.next_hop }} dev {{ route_dev[r.prefix|string] }}
{% endif %}
{% endfor %}
{% if filters %}
iptables -P FORWARD ACCEPT
iptables -F FORWARD
iptables -F INPUT
{% for f in filters %}
{% for p in f.policies %}
{% set rule %}{{ "-i" if f.direction == "in" else "-o" }} {{ f.interface }} -s {{ p.src }} -d {{ p.dst }}{% if p.protocol != "ip" %} -p {{ p.protocol }}{% endif %}{% if p.dst_port %} -m {{ p.protocol }} --dport {{ p.dst_port }}{% endif %} -j {{ "DROP" if p.action == "deny" else "ACCEPT" }}{% endset %}
iptables -A FORWARD {{ rule }}
{% if f.direction == "in" %}
iptables -A INPUT {{ rule }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
